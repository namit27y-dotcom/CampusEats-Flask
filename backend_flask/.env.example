# CampusEats Flask Backend Environment Configuration Template
# Duplicate this file as .env and fill in your local environment credentials

PORT=5000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campuseats_db
DB_PORT=3306

# Security & Authentication
JWT_SECRET=your_secure_jwt_secret_key_change_in_production

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI Recommendation Service (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application Origin
FRONTEND_URL=http://localhost:5173
